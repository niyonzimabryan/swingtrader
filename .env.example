# ============================================
# Swing Trader - Environment Configuration
# ============================================
# Recommended setup:
#   python -m scripts.setup_wizard
#
# Manual setup:
#   cp .env.example .env
#   Fill every required core/trading/data key below.
#
# Gemini is the only research key intentionally treated as an optional add-on.
#
# Where each key actually lives (three env surfaces):
#   * This file / a local .env  — the full set for running SwingTrader yourself.
#   * Repo .env (dev machine)   — a LOCAL SUBSET only: Anthropic + Gemini + a
#                                 SQLite DATABASE_URL + LANGFUSE_BASE_URL. Enough
#                                 to run tests and offline tooling; the ~8 doctor
#                                 FAILs for absent broker/data keys are expected.
#   * Railway (production)      — the authoritative FULL set of secrets, managed
#                                 via `railway variables`. Never committed.
#   * ~/.env (operator machine) — LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY for
#                                 local trace pushes; the repo .env only carries
#                                 LANGFUSE_BASE_URL.
# Rule: secrets never get committed. `.env.example` documents shape + defaults;
# real values live in the local .env, Railway, or ~/.env per the split above.

# --- Core AI: required ---
# Claude runs the core analysis, scoring, memo writing, and Anthropic web search.
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Telegram: required ---
# 1. Message @BotFather on Telegram.
# 2. Send /newbot and follow the prompts.
# 3. Paste the generated token below.
# 4. Send /start to your new bot.
# 5. The setup wizard can discover TELEGRAM_CHAT_ID automatically.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Alpaca paper trading: required ---
# Register: https://app.alpaca.markets
# Use Paper Trading keys only.
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Broker and execution mode ---
# Modes:
#   review_only = broker review/audit only, no placement
#   paper       = Alpaca paper placement
#   live        = primary broker placement when ALLOW_LIVE_TRADING=true
BROKER_PRIMARY=alpaca
BROKER_PAPER=alpaca
EXECUTION_MODE=paper
ALLOW_LIVE_TRADING=false
REQUIRE_ORDER_REVIEW=true

# --- Robinhood Agentic Trading MCP ---
# Robinhood live trading uses a dedicated Agentic account through MCP.
# Do not commit OAuth tokens. Prefer local MCP/OAuth auth; auth token/header
# knobs exist only for service-side deployments with a managed token store.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_ACCOUNT_NUMBER=
ROBINHOOD_MCP_AUTH_TOKEN=
ROBINHOOD_MCP_HEADERS_JSON=
# Fernet key for the encrypted OAuth token store (database/token_store.py).
# Generate: python -m scripts.robinhood_auth --gen-key
# Set as a deployment secret; back it up out-of-band (loss => re-auth).
TOKEN_ENCRYPTION_KEY=
ROBINHOOD_ACCOUNT_BUDGET=25
ROBINHOOD_MAX_ORDER_NOTIONAL=5
ROBINHOOD_MAX_DAILY_NOTIONAL=10
ROBINHOOD_MAX_OPEN_POSITIONS=3
ROBINHOOD_ALLOW_FRACTIONAL=true
ROBINHOOD_ALLOW_OPTIONS=false
ROBINHOOD_ALLOWED_SYMBOLS=
ROBINHOOD_BLOCKED_SYMBOLS=
ROBINHOOD_ORDER_TYPE=market
ROBINHOOD_MARKET_HOURS=regular_hours
ALPACA_ENABLED=true
ALPACA_PAPER_ONLY=true

# --- Market/data providers: required ---
# Finnhub: news, earnings, analyst recommendations, price targets.
# Register: https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key

# Financial Modeling Prep: fundamentals and pattern-data fallback coverage.
# Register: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key

# Alpha Vantage: backup financial data provider.
# Register: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# FRED: macro rates, yield curve, and credit spread inputs.
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# --- Runtime: required ---
# Selects the database engine. SQLite is the local and current deployed default;
# Postgres is supported with the same code path and the same schema, applied by
# Alembic (see docs/DATABASE_ENGINES.md and migrations/README.md).
#   sqlite:///swing_trader.db
#   sqlite:////data/swing_trader.db                             (Railway volume)
#   postgresql+psycopg://user:password@host:5432/swingtrader
DATABASE_URL=sqlite:///swing_trader.db

# Directory for sidecar files that must survive a restart: the pattern-backfill
# queue and the encrypted Robinhood token blob. Left empty it is derived from a
# sqlite:/// DATABASE_URL, which stops working the moment DATABASE_URL is a
# Postgres URL — so set it explicitly at the cutover (Railway: /data).
DATA_DIR=

# --- Workspace API / MCP service (spec K) --------------------------------
# A SEPARATE Railway service (railway.workspace.toml, `python -m
# workspace.server`). The bot does not import it and does not need any of
# these. Off by default: with the flag false the service still answers /health
# so a deploy is observable, and refuses every authenticated call with 503.
WORKSPACE_API_ENABLED=false
# Server side: bind address. Railway injects $PORT, which wins over the port.
WORKSPACE_HOST=0.0.0.0
WORKSPACE_PORT=8000
# Per-token rate limits (spec K section 4.1). A runaway agent loop must cost
# time, not money.
WORKSPACE_READ_RATE_LIMIT_PER_MINUTE=60
WORKSPACE_WRITE_RATE_LIMIT_PER_MINUTE=10
# OAuth 2.1 + dynamic client registration is designed, not implemented
# (workspace/oauth.py). True only advertises protected-resource metadata.
WORKSPACE_OAUTH_ENABLED=false

# --- Portfolio ledger (Spec L) ---
# The hourly broker sync that fills holdings/tax_lots/cash_balances/broker_orders.
# Off by default: with it false the tables exist and the workspace read tools
# answer from an empty ledger with stale=true rather than inventing anything.
PORTFOLIO_SYNC_ENABLED=false
# Freshness budget in minutes. Past it every read tool sets stale=true, and any
# path that would feed an order proposal refuses rather than serving.
PORTFOLIO_FRESHNESS_BUDGET_MINUTES=60
# Sync cadence: every N minutes during market hours, plus pre-market and after
# the close. Hours/minutes are US Eastern.
PORTFOLIO_SYNC_INTERVAL_MINUTES=60
PORTFOLIO_SYNC_PRE_MARKET_HOUR=8
PORTFOLIO_SYNC_POST_CLOSE_HOUR=16
PORTFOLIO_SYNC_POST_CLOSE_MINUTE=30
# A sync that would drop more than this fraction of an account's known holdings
# fails closed and pages instead of writing.
PORTFOLIO_MASS_DELETION_THRESHOLD=0.5
# Client side: where the workspace answers, and the bearer token for it. The
# token is issued once by `python -m scripts.workspace_token --issue --label
# ...`, shown once, and stored only as a SHA-256 digest. Never commit it.
# See docs/WORKSPACE_ACCESS.md.
WORKSPACE_BASE_URL=
WORKSPACE_TOKEN=

# --- Research workspace: dossiers, theses, invalidators, journal (spec M) ---
# Off by default. With this false the five research tools are not registered on
# the MCP surface at all, the daily invalidator check is a no-op, and
# `python -m scripts.sync_research_mirror` refuses to touch the mirror.
# See docs/RESEARCH_WORKSPACE.md.
RESEARCH_WORKSPACE_ENABLED=false
# A dossier section older than this is marked `stale` in every response that
# includes it (spec M section 6). Marked, never hidden.
RESEARCH_SECTION_STALE_DAYS=90
# Where the Markdown mirror is written, relative to the repository root.
RESEARCH_MIRROR_DIR=research
# Small-n floors (spec M section 6). Below them the metrics print
# `insufficient` rather than a number nobody should act on.
RESEARCH_BRIER_MIN_RESOLVED=10
RESEARCH_CALIBRATION_MIN_RESOLVED=40
RESEARCH_CALIBRATION_COARSE_BELOW=100

# Start with scheduler disabled while validating Telegram and paper trading.
# Set true after /eval AAPL works.
SCHEDULER_ENABLED=false

# --- Trading/risk defaults: optional tuning ---
PORTFOLIO_VALUE=100000.0
BASE_POSITION_PCT=0.05
MAX_POSITION_PCT=0.10
MIN_POSITION_PCT=0.02
MAX_PORTFOLIO_EXPOSURE=0.80
MAX_SECTOR_EXPOSURE=0.30
MAX_CONCURRENT_POSITIONS=8
DEFAULT_STOP_LOSS_PCT=0.05
MAX_STOP_LOSS_PCT=0.08
MAX_HOLDING_DAYS=20
DRAWDOWN_CIRCUIT_BREAKER_PCT=0.10
DAILY_LOSS_HALT_PCT=0.03

# --- Scoring/model defaults: optional tuning ---
MEMO_THRESHOLD=0.55
HIGH_CONVICTION_THRESHOLD=0.75
CATALYST_ESCALATION_THRESHOLD=3
# Scan-complete alert fires once per scan when >= this fraction of tickers failed processing (BRY-301)
CATALYST_FAILURE_RATE_ALERT_THRESHOLD=0.9
SCORING_MODEL=claude-opus-4-6
ANALYST_MODEL=claude-sonnet-5
FILTER_MODEL=claude-haiku-4-5-20251001

# --- Spec I0: Funnel guardrails (optional tuning) ---
# Keep only the top-N tier-2 escalations by Gemini score before catalyst.
TIER2_MAX_ESCALATIONS=25
# Hard cap on the merged scan list entering catalyst (applied after priority
# ordering, so higher-priority sources are never evicted for lower ones).
SCAN_MAX_CATALYST_TICKERS=40

# --- Spec I1: Shadow calibration ledger (optional tuning) ---
# Max rows the nightly forward-returns job computes per run (price fetches).
SHADOW_RETURNS_MAX_PER_RUN=300

# --- Spec I2: Paper autonomy sandbox (optional; PAPER-ONLY, off by default) ---
# Master switch. Auto-approval is structurally refused outside the Alpaca PAPER
# adapter regardless of this flag. Enable only after credits are restored and
# one supervised scan (see CONTRIBUTING release-steps rule).
AUTO_APPROVE_PAPER=false
AUTO_APPROVE_MIN_SCORE=0.55
EXPLORATION_BAND_ENABLED=true
EXPLORATION_MIN_SCORE=0.45
AUTO_MAX_CONCURRENT_POSITIONS=8
AUTO_MAX_NEW_POSITIONS_PER_SCAN=4
EXPLORATION_MAX_NEW_PER_SCAN=2
EXPLORATION_POSITION_PCT_FACTOR=0.5

# --- Schedule defaults: optional tuning, Eastern Time hours ---
PRE_MARKET_HOUR=7
MIDDAY_HOUR=12
POST_MARKET_HOUR=17
SCHEDULER_MISFIRE_GRACE_TIME_S=7200

# --- Monitor reliability (Spec B: hang recovery) ---
# Hard timeout (seconds) on every broker/price call in the position & order
# monitors so a stuck Alpaca call can't freeze the async loop.
MONITOR_BROKER_CALL_TIMEOUT_S=30
# Watchdog: if a monitor loop stops ticking for this many seconds during market
# hours, the process exits(1) so Railway's ON_FAILURE policy restarts it.
MONITOR_WATCHDOG_STALE_S=900
# How often (seconds) the watchdog checks the monitors' last-tick timestamps.
MONITOR_WATCHDOG_INTERVAL_S=300
# Daily clean self-restart, "HH:MM" 24h ET (blank/None disables). Runs regardless
# of SCHEDULER_ENABLED so no hang can outlive a trading day.
DAILY_RESTART_TIME_ET=08:57

# --- Gemini add-on: optional, recommended for search-heavy stages ---
# By default, discovery and web research use Gemini Pro + Google Search grounding.
# If GEMINI_API_KEY is blank, the app can fall back to Anthropic web search.
# Register: https://aistudio.google.com/app/apikey
WEB_SEARCH_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash
GEMINI_DISCOVERY_MODEL=gemini-2.5-flash
GEMINI_WEB_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_FLASH_ESCALATION_THRESHOLD=0.50
# Grounded tier-2 output includes a prose preamble; 512/2048 truncate mid-JSON. 4096 fits.
GEMINI_FLASH_MAX_OUTPUT_TOKENS=4096
DISCOVERY_MAX_TICKERS=12
DISCOVERY_MODEL=claude-sonnet-5
DISCOVERY_OUTPUT_MAX_TOKENS=8192
DISCOVERY_MAX_SEARCHES=8
DISCOVERY_THINKING_BUDGET=0
OPUS_THINKING_BUDGET=16000
WEB_RESEARCH_MAX_SEARCHES=5
WEB_RESEARCH_CACHE_ENABLED=true
WEB_RESEARCH_CACHE_TTL_HOURS=24
DEEP_RESEARCH_PROVIDER=gemini
DEEP_RESEARCH_SCORE_THRESHOLD=0.75

# --- Historical Pattern Analog Engine: optional, off by default ---
# Master switch. When false, the legacy pattern path runs unchanged.
PATTERN_ANALOG_ENGINE_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_SEARCH_ENABLED=true
PERPLEXITY_SEARCH_MAX_REQUESTS_PER_RUN=20
PATTERN_EVENT_SEARCH_PROVIDER=gemini
PATTERN_EVENT_SEARCH_ENABLED=true
PATTERN_EVENT_CACHE_TTL_DAYS=90
PATTERN_PEER_CACHE_TTL_DAYS=30
PATTERN_MAX_PEER_COUNT=20
PATTERN_MIN_DIRECT_MATCHES=5
PATTERN_MIN_TOTAL_MATCHES=10
PATTERN_MAX_SEARCH_QUERIES_PER_CATALYST=8
PATTERN_MAX_EVENTS_PER_QUERY=10
PATTERN_EMBEDDING_PROVIDER=gemini
PATTERN_STAGE_WALLCLOCK_BUDGET_S=45
PATTERN_COLD_TICKER_ASYNC_BACKFILL=true
PATTERN_PRICE_SOURCE=fmp
# Relative queue paths resolve against the DB directory (prod: /data/), not cwd,
# so the queue survives container redeploys. Absolute paths are used as-is.
PATTERN_BACKFILL_QUEUE_PATH=.pattern_backfill_queue.jsonl
# Cap on store-time (inline) outcome computation per scan, so live scans stay bounded.
PATTERN_INLINE_OUTCOME_MAX_PER_SCAN=10
# Cap on tickers drained from the backfill queue per scheduled run (3 AM ET job).
PATTERN_BACKFILL_MAX_TICKERS_PER_RUN=20

# --- Watchlist defaults: optional tuning ---
WATCHLIST_HAIKU_THRESHOLD=2
WATCHLIST_MAX_SIZE=25

# --- Firecrawl: optional narrative scraper + paywall fallback ---
# Used by web research + catalyst agents to fetch full article bodies (earnings
# transcripts, paywalled news). Free tier covers typical use (~50 calls/day).
# Without this key the agents fall back to grounded LLM search and headline-only
# catalyst summaries — SwingTrader runs fine, narrative depth is reduced.
# Register: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CALLS_PER_SCAN=50
ARCHIVE_IS_ENABLED=true

# --- Langfuse observability: optional ---
# Register: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- Advanced/future integrations: optional ---
# OpenAI deep research is not required by the current setup path.
OPENAI_API_KEY=


# --- Pipeline parallelization defaults ---
PARALLEL_AGENTS_ENABLED=true
PARALLEL_AGENTS_SCOPE=both
PARALLEL_WORKERS_DEFAULT=3
PARALLEL_WORKERS_DEGRADED=2
PARALLEL_TIMEOUT_FUNDAMENTAL_S=180
PARALLEL_TIMEOUT_PATTERN_S=300
PARALLEL_TIMEOUT_WEB_RESEARCH_S=300

# --- Parallel stability controller defaults ---
PARALLEL_AUTO_DEGRADE_ENABLED=true
PARALLEL_BAD_RUN_WINDOW=12
PARALLEL_BAD_RUN_COUNT_TRIGGER=3
PARALLEL_COOLDOWN_RUNS=20
PARALLEL_RECOVERY_GOOD_RUNS=8
PARALLEL_ALERT_ON_STATE_CHANGE=true

# --- Comparable setups (Spec N, Phase 3c) ---
# The cohort engine: point-in-time cohorts from stored facts, the §8 answer
# contract, and the `compare_setups` / `cohort_detail` MCP tools.
# Docs: docs/COMPARABLE_SETUPS.md
# Off by default, and off means the two tools are NOT REGISTERED — an
# unregistered tool is a clearer refusal than one that answers "disabled".
COMPARABLE_SETUPS_ENABLED=false
# The stored universe membership is read from, as of each event date. A universe
# with no universe_membership rows for the period caps the cohort at
# `archival_reconstructed`: membership from today's list is survivorship bias
# wearing a disguise.
COMPARABLE_UNIVERSE_SLUG=liquid_us_equity_v1
# The named price-file vintage cohorts run against. Its delisting audit must be
# recorded (scripts/audit_delisting_returns.py) or the cohort cannot reach
# `vendor_pit`: a file that stops at the last quote looks identical to one that
# carried the terminal collapse.
COMPARABLE_PRICE_SNAPSHOT=dev
# The security_uid in price_bars every abnormal return is measured against.
# REQUIRED: a missing benchmark is a configuration error, not a default, because
# "+4.1% average" during a period the index rose 4.0% is the whole of Spec N
# failure mode 4.
COMPARABLE_BENCHMARK_SECURITY_UID=
# The named execution policy the §5.3 policy-simulated leg replays under. An
# unknown slug is refused rather than defaulted to something plausible.
COMPARABLE_EXECUTION_POLICY=event_swing_14cal_v1
# Bootstrap replications. `quick` trades interval precision for latency; `full`
# is what a citable answer uses.
COMPARABLE_QUICK_BOOTSTRAP_REPS=1000
COMPARABLE_FULL_BOOTSTRAP_REPS=10000
# TICKER:CIK,TICKER:CIK — the join market_cap_decile needs, because the price
# plane's security master carries no CIK and the SEC feed stamps a ticker.
# Empty means every name is REFUSED a market-cap decile rather than given one
# computed from a share count it could not have had. Phase 4's entity-history
# plane replaces this with a stored point-in-time mapping.
COMPARABLE_CIK_MAP=
# The floors are NOT environment variables, deliberately:
# COHORT_FLOOR_DISTINCT_DATES=20 and COHORT_FLOOR_MATURED=30 live in
# comparables/config.py. Lowering a floor changes what the system is willing to
# call evidence, and that belongs in a diff somebody reviews.

# --- Price plane (Spec N §4.2/§4.3, Phase 3p) ---
# The historical price backbone the comparable-setups engine runs on. Additive
# and off by default: the incumbent yfinance path is untouched, and every
# price-plane script refuses while this is false.
# Docs: docs/PRICE_PLANE.md
PRICE_PLANE_ENABLED=false
# fixture | sharadar. `fixture` reads the committed CSVs under
# tests/fixtures/prices/ and needs no key or network.
PRICE_PLANE_SOURCE=fixture
# Nasdaq Data Link key for the Sharadar tables (SEP, ACTIONS, TICKERS, SP500).
# The one paid feed in the stack, ~$9/mo. Register: https://data.nasdaq.com/
# Leave empty and the Sharadar plane refuses to construct rather than calling
# anonymously; the fixture source keeps working.
NASDAQ_DATA_LINK_API_KEY=
# Named vintage of the price file that backfills and audits write against, so a
# cohort can record which snapshot it ran on.
PRICE_PLANE_SNAPSHOT=dev
# liquid_us_equity_v1: top N by 20-session median dollar volume at each
# month-end. Liquidity only — market-cap ranking waits for the Phase 3a
# share-count feed (docs/PRICE_PLANE.md).
LIQUID_UNIVERSE_TOP_N=500
LIQUID_UNIVERSE_WINDOW_SESSIONS=20
# Delisting audit (Spec N §4.2): a terminal return over this many sessions,
# below this threshold, means the file carried the collapse rather than
# stopping at the last quote.
DELISTING_AUDIT_WINDOW_SESSIONS=10
DELISTING_AUDIT_COLLAPSE_THRESHOLD=-0.60


# --- Spec O evidence planes: filings, macro vintages, news ---
# Every plane is off by default. When a flag is false the plane's ingest
# refuses to run; reads of what is already stored keep working, because a
# table is not a capability.

# Phase 3a — the minimum SEC ingestion contract (XBRL companyfacts,
# submissions acceptance timestamps, the 8-K Item 2.02 index).
PLANE_SEC_MINIMAL_ENABLED=false
# Phase 4 — Form 4, 13D/G, the full 8-K item index, entity history, CUSIP.
PLANE_FILINGS_ENABLED=false
# Phase 4 — ALFRED vintages and the regime_v1 classifier.
PLANE_MACRO_VINTAGE_ENABLED=false
# Phase 4 — timestamped, clustered news.
PLANE_NEWS_ENABLED=false

# SEC requires a self-identifying User-Agent of the form
# "Sample Company Name AdminContact@<domain>.com"
# (https://www.sec.gov/os/webmaster-faq). There is no default in code: a real
# contact address must never be committed, and a made-up one is worse than
# none. filings/client.py raises until this is set.
SEC_USER_AGENT=
# SEC's published maximum is 10 requests/second. The client refuses higher.
SEC_MAX_REQUESTS_PER_SECOND=10.0
SEC_REQUEST_TIMEOUT_S=30.0
SEC_MAX_RETRIES=4

# OpenFIGI: CUSIP -> FIGI -> ticker for ownership tables. Free; the key only
# raises the limits (25/min and 10 jobs per request without one, 25 per 6s and
# 100 jobs with one). Leave blank to run keyless and slower.
# Register: https://www.openfigi.com/api
OPENFIGI_API_KEY=
OPENFIGI_TIMEOUT_S=30.0

# Alpaca News (Benzinga-sourced) is the primary timestamped news source and
# reuses ALPACA_API_KEY / ALPACA_SECRET_KEY above. Note Alpaca's terms bar
# redistributing the data "or any derived products": nothing news-derived may
# leave Postgres (Spec O section 5).
ALPACA_NEWS_BASE_URL=https://data.alpaca.markets
ALPACA_NEWS_REQUESTS_PER_MINUTE=200
ALPACA_NEWS_TIMEOUT_S=30.0
# Finnhub is the cross-check for the earliest-timestamp rule, not a primary.
FINNHUB_NEWS_REQUESTS_PER_MINUTE=60

# Near-duplicate story clustering (MinHash/LSH). Cluster ids are only
# comparable across runs at fixed parameters — do not tune these per run.
NEWS_MINHASH_PERMUTATIONS=128
NEWS_CLUSTER_JACCARD_THRESHOLD=0.5
NEWS_SHINGLE_SIZE=5

# --- Execution lifecycle: proposal -> approval -> placement (Spec L §6, Phase 6) ---
# The one path that can reach live capital. Off by default: with this false the
# propose_order MCP tool is not registered and every approval callback is
# refused. See docs/EXECUTION_LIFECYCLE.md for the full state machine and the
# owner's live-probe runbook.
PHASE6_EXECUTION_ENABLED=false
# HMAC key for the signed, single-use, expiring approval reference. Unset means
# no approval card can be minted or verified, so nothing can be approved — the
# intended failure. Set a strong random value before enabling the flag.
EXECUTION_APPROVAL_SECRET=
# risk_fraction is a FRACTION of equity (0.005 = half a percent). At or above
# the percentage floor it is refused as a percentage typed as a fraction; above
# the hard cap it is refused, never silently clamped.
RISK_FRACTION_HARD_CAP=0.01
RISK_FRACTION_PERCENTAGE_FLOOR=0.05
# The two budgets (§6.6). They never share a number. Daily notionals of 0 mean
# "not configured" and do not bind.
EVIDENCED_RISK_CAP=0.01
EVIDENCED_DAILY_NOTIONAL=0.0
DISCRETIONARY_RISK_CAP=0.0025
DISCRETIONARY_DAILY_NOTIONAL=0.0
# advisory (default, owner decision 2026-09-08) never sizes to zero on evidence
# alone — a weak citation is re-labelled discretionary with the evidence shown.
# strict makes LB<=0 size to zero and refuses an uncited proposal, no code change.
EVIDENCE_GATE_MODE=advisory
# A cited cohort answer older than this many trading sessions is not a citation.
CITATION_MAX_AGE_SESSIONS=5
# Fill -> stop placed -> stop READ BACK from the broker. Past this window a
# filled position is marked unprotected, pages, and blocks further entries.
PROTECTION_WINDOW_SECONDS=120
PROTECTION_POLL_INTERVAL_SECONDS=2.0
# How long an approval card stays valid (single-use and owner-bound too).
APPROVAL_TTL_SECONDS=1800
# Concentration and sector caps over the COMBINED book across all accounts,
# separate from the scan bot's own caps so Phase 6 cannot move production limits.
PROPOSAL_MAX_POSITION_PCT=0.10
PROPOSAL_MAX_SECTOR_PCT=0.30
# NOTE: the kill switch is not an env var — it is a persistent database row set
# with /live_kill on|off, so it survives restart (Spec L §6.5). Live placement
# additionally requires ALLOW_LIVE_TRADING=true and EXECUTION_MODE=live above.

# --- Strategy Lab: shadow integration and operator controls (Spec Q §14, PR 4) ---
# Two gates, both off. The master switch gates the import, the scheduled job and
# the owner-only Telegram commands; the shadow switch gates the one path that
# writes — the post-scan hook that builds a snapshot and runs the registered
# shadow arms. With STRATEGY_LAB_ENABLED=false the scan, the memos, the paper
# auto-approve pass and every broker path behave exactly as they do today, and
# nothing new is written. The paper and live flags are below:
# PR 6 added them together with the services that read them. See
# docs/STRATEGY_LAB.md and docs/ENV_SETUP.md §10.
STRATEGY_LAB_ENABLED=false
STRATEGY_LAB_SHADOW_ENABLED=false
# The pre-registered experiment the shadow arms run under. Its analysis plan is
# a constant in orchestrator/strategy_lab_shadow.py, because Spec Q §8 freezes
# the question at registration: changing the roster or the planned variant count
# means registering a NEW name here. Re-registering this one with a changed plan
# is refused, which is the point.
STRATEGY_LAB_EXPERIMENT=shadow_roster_v1
STRATEGY_LAB_EXPERIMENT_OWNER=bryan
# Cross-sectional (universe-scoped) arms need universe_membership rows and a
# populated price plane, so their one-per-cutoff snapshot is its own opt-in even
# when shadow is on. Leave false until PRICE_PLANE_ENABLED is true and the
# membership table is backfilled.
STRATEGY_LAB_UNIVERSE_ENABLED=false
STRATEGY_LAB_UNIVERSE_SLUG=liquid_us_equity_v1
# Hard cap on ticker snapshots built per scan, applied after the scan's own
# priority ordering.
STRATEGY_LAB_MAX_TICKERS_PER_SCAN=40
# The shadow book: independent VIRTUAL budgets (Spec Q §11). These numbers never
# touch broker capital; they exist so a percentage return and an R multiple are
# computable, and the scorecard ranks on percentages precisely because those do
# not depend on the virtual budget an arm happened to get.
STRATEGY_LAB_SHADOW_EQUITY=100000.0
STRATEGY_LAB_SHADOW_RISK_BUDGET=0.01
STRATEGY_LAB_SHADOW_MAX_OPEN_POSITIONS=10
STRATEGY_LAB_SHADOW_MAX_POSITION_FRACTION=0.2
# Nightly maturation: how many (arm, snapshot) pairs one run may settle.
STRATEGY_LAB_MATURATION_MAX_SNAPSHOTS=200
# Explicit cost assumptions. metrics.py blocks an arm's return metrics outright
# when a matured trade has no cost model — a zero-cost result is not a cheap
# one, it is a wrong one.
STRATEGY_LAB_SLIPPAGE_BPS=10.0
STRATEGY_LAB_HALF_SPREAD_BPS=5.0
STRATEGY_LAB_COMMISSION_BPS=0.0
# Evidence floors (Spec Q §10) and the confidence level, printed beside every
# number the scoreboard shows.
STRATEGY_LAB_FLOOR_MATURED=100
STRATEGY_LAB_FLOOR_DISTINCT_DATES=20
STRATEGY_LAB_FLOOR_CLOSED=30
STRATEGY_LAB_CONFIDENCE_LEVEL=0.90
# Bootstrap replications and seed for the operator-facing card. The seed is
# printed on the card, so the same numbers reproduce from
# scripts/strategy_lab_scoreboard.py.
STRATEGY_LAB_REPORT_BOOTSTRAP_REPS=1000
STRATEGY_LAB_REPORT_SEED=20260910

# --- Strategy Lab: the tiers above shadow (Spec Q §11, §12, §14, PR 6) ---
# Both false, and each tier needs every gate below it as well as its own. PAPER
# turns on the post-scan paper dispatcher and the three scheduled execution jobs
# (resume, expire-stale, reconcile); it requires STRATEGY_LAB_ENABLED,
# PHASE6_EXECUTION_ENABLED and an Alpaca paper adapter, and it can only ever
# reach Alpaca paper — a paper arm refuses any other venue whatever
# EXECUTION_MODE or BROKER_PRIMARY say. LIVE is the Strategy Lab's own live
# gate, on top of ALLOW_LIVE_TRADING, EXECUTION_MODE=live, the kill switch, the
# broker's declared exit capability, and an owner promotion_event for the one
# global champion arm. Promotion is never entry approval: every proposed live
# execution still needs its own signed, expiring, single-use owner callback.
STRATEGY_LAB_PAPER_ENABLED=false
STRATEGY_LAB_LIVE_ENABLED=false
# The paper book: independent VIRTUAL budgets, separate from the shadow book and
# from the production ledger (Spec Q §11). These decide what a paper arm
# proposes; Phase 6's own caps apply on top and can only shrink an order.
STRATEGY_LAB_PAPER_EQUITY=100000.0
STRATEGY_LAB_PAPER_RISK_BUDGET=0.005
STRATEGY_LAB_PAPER_MAX_OPEN_POSITIONS=5
STRATEGY_LAB_PAPER_MAX_POSITION_FRACTION=0.1
# Per-arm virtual notional per dispatch day. 0 means "not configured" and does
# not bind, the same convention as Phase 6's daily notional.
STRATEGY_LAB_PAPER_DAILY_NOTIONAL=0.0
# How many executions one dispatch pass may propose across all paper arms.
STRATEGY_LAB_PAPER_MAX_PROPOSALS_PER_RUN=5
# Spec Q §12 invariant 7: a stale snapshot means abstain. A paper dispatch
# prices its entry reference off the decision's own snapshot close, so the
# snapshot's age IS the quote's age.
STRATEGY_LAB_PAPER_MAX_SNAPSHOT_AGE_MINUTES=90
# Promotion evidence floors. Separate from the scoreboard's display floors above
# because these gate a tier change rather than a printed number (Spec Q §10).
STRATEGY_LAB_PROMOTION_FLOOR_SHADOW_MATURED=100
STRATEGY_LAB_PROMOTION_FLOOR_PAPER_CLOSED=30
# The risk budget a newly prepared LIVE arm is given. Zero is not a placeholder:
# a live arm with no budget can be the global champion and still place nothing,
# because sizing multiplies by it. Setting a number here is a separate,
# deliberate owner authorization, and the promotion card prints the budget it
# binds either way (Spec Q §3).
STRATEGY_LAB_LIVE_RISK_BUDGET=0.0
# How long a /promote_arm confirmation card stays valid.
STRATEGY_LAB_PROMOTION_TTL_SECONDS=300
